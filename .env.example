# Local development environment. Copy to .env and adjust:
#
#   cp .env.example .env
#
# .env is git-ignored (.env.example is not). Nothing here is a real secret — these are
# local-development defaults, and every value is also defaulted in the services'
# application.yml so the stack runs without a .env at all.

# --- Database ---------------------------------------------------------------------------
# appuser is the bootstrap/admin role: it owns the database, installs uuid-ossp and backs
# the pg_isready healthcheck. No service authenticates as it.
POSTGRES_APP_PASSWORD=changeme-dev-only

# One login role per service, each granted only on its own schema (ADR-0007). The same
# value is given to Postgres (postgres-init/02-service-roles.sh sets the role's password)
# and to the service that authenticates with it, so they cannot drift.
POSTGRES_ORDER_PASSWORD=changeme-dev-only
POSTGRES_PAYMENT_PASSWORD=changeme-dev-only
POSTGRES_INVENTORY_PASSWORD=changeme-dev-only

# --- Keycloak (auth-service, ADR-0018) --------------------------------------------------
# Admin console at http://localhost:8180 . Local only.
KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=admin

# --- OAuth2 / JWT (ADR-0009) ------------------------------------------------------------
# Every service validates access tokens itself against this issuer: RS256 signature via the
# JWKS endpoint (honouring kid rotation), plus issuer, audience and expiry.
#
# The issuer is the Keycloak realm URL, and the `iss` claim is compared by exact string
# equality — so one URL has to be valid both inside the compose network and from the host.
# deploy/local/compose.yaml resolves this by pinning Keycloak's frontend URL
# (KC_HOSTNAME=http://keycloak:8080): every token it mints carries
# iss=http://keycloak:8080/realms/order-platform no matter which address the caller used,
# and the containers are configured with that same string. The compose file sets that value
# for the services directly, so it is NOT read from here.
#
# The value below is what the HOST-side scripts use to reach Keycloak (scripts/get-token.sh,
# make token): Keycloak is published on localhost:8180 and issues tokens there happily.
JWT_ISSUER_URI=http://localhost:8180/realms/order-platform

# Derived from JWT_ISSUER_URI by Keycloak convention; override only if Keycloak is fronted
# differently (e.g. an internal JWKS URL distinct from the public issuer).
# JWT_JWKS_URI=http://localhost:8180/realms/order-platform/protocol/openid-connect/certs

# Audience the services require in the `aud` claim. Stamped by the realm export's
# order-platform-audience client scope; rejecting tokens minted for other relying parties is
# the reason this check exists.
JWT_AUDIENCE=order-platform

# --- Demo user (from the realm export) --------------------------------------------------
DEMO_USERNAME=demo-customer
DEMO_PASSWORD=demo-password
DEMO_CLIENT_ID=order-platform-web

# --- api-gateway ------------------------------------------------------------------------
# Where the gateway forwards /api/v1/orders. In compose this is set to the container
# hostname (http://order-service:8080) by deploy/local/compose.yaml; the value below is for
# running the gateway on the host against a host-run order-service.
ORDER_SERVICE_URI=http://localhost:8080

# Per-client rate limit: burst size and sustained requests per second (429 + Retry-After
# when exhausted).
RATE_LIMIT_CAPACITY=60
RATE_LIMIT_REFILL_PER_SECOND=20

# --- Local stack host ports (deploy/local/compose.yaml) ---------------------------------
# Only these four are published; order/payment/inventory stay internal so the gateway is
# the single entry point. Change one if it clashes with something already on your machine.
GATEWAY_HOST_PORT=8090
KEYCLOAK_HOST_PORT=8180
POSTGRES_HOST_PORT=5432
KAFKA_HOST_PORT=29092
