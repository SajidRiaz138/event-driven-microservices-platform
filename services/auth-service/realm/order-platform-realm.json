{
  "realm": "order-platform",
  "displayName": "Order Platform",
  "enabled": true,
  "sslRequired": "none",
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "bruteForceProtected": true,
  "defaultSignatureAlgorithm": "RS256",
  "accessTokenLifespan": 900,
  "ssoSessionIdleTimeout": 1800,
  "ssoSessionMaxLifespan": 36000,
  "revokeRefreshToken": true,
  "refreshTokenMaxReuse": 0,
  "clientScopes": [
    {
      "name": "basic",
      "description": "Standard claims every token carries (sub, auth_time). Keycloak built-in.",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "false",
        "display.on.consent.screen": "false"
      },
      "protocolMappers": [
        {
          "name": "sub",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-sub-mapper",
          "consentRequired": false,
          "config": {
            "introspection.token.claim": "true",
            "access.token.claim": "true"
          }
        },
        {
          "name": "auth_time",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usersessionmodel-note-mapper",
          "consentRequired": false,
          "config": {
            "user.session.note": "AUTH_TIME",
            "introspection.token.claim": "true",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "claim.name": "auth_time",
            "jsonType.label": "long"
          }
        }
      ]
    },
    {
      "name": "profile",
      "description": "OpenID Connect profile claims (preferred_username, name). Keycloak built-in.",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "true",
        "display.on.consent.screen": "true",
        "consent.screen.text": "${profileScopeConsentText}"
      },
      "protocolMappers": [
        {
          "name": "username",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "consentRequired": false,
          "config": {
            "introspection.token.claim": "true",
            "userinfo.token.claim": "true",
            "user.attribute": "username",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "claim.name": "preferred_username",
            "jsonType.label": "String"
          }
        },
        {
          "name": "full name",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-full-name-mapper",
          "consentRequired": false,
          "config": {
            "id.token.claim": "true",
            "access.token.claim": "true",
            "introspection.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        }
      ]
    },
    {
      "name": "email",
      "description": "OpenID Connect email claims. Keycloak built-in.",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "true",
        "display.on.consent.screen": "true",
        "consent.screen.text": "${emailScopeConsentText}"
      },
      "protocolMappers": [
        {
          "name": "email",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "consentRequired": false,
          "config": {
            "introspection.token.claim": "true",
            "userinfo.token.claim": "true",
            "user.attribute": "email",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "claim.name": "email",
            "jsonType.label": "String"
          }
        }
      ]
    },
    {
      "name": "order-platform-audience",
      "description": "Stamps aud=order-platform so every resource server can enforce the audience check (ADR-0009).",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "false",
        "display.on.consent.screen": "false"
      },
      "protocolMappers": [
        {
          "name": "order-platform-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.custom.audience": "order-platform",
            "id.token.claim": "false",
            "access.token.claim": "true",
            "introspection.token.claim": "true"
          }
        }
      ]
    },
    {
      "name": "orders:read",
      "description": "View your own orders.",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "true",
        "display.on.consent.screen": "true",
        "consent.screen.text": "View your orders"
      }
    },
    {
      "name": "orders:write",
      "description": "Place orders as yourself.",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "true",
        "display.on.consent.screen": "true",
        "consent.screen.text": "Place orders on your behalf"
      }
    },
    {
      "name": "orders:write:any",
      "description": "Place orders on behalf of another customer (administrative, audited). Optional scope: it is only granted when explicitly requested.",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "true",
        "display.on.consent.screen": "true",
        "consent.screen.text": "Place orders for any customer"
      }
    }
  ],
  "defaultDefaultClientScopes": [
    "basic",
    "profile",
    "email",
    "order-platform-audience"
  ],
  "defaultOptionalClientScopes": [],
  "clients": [
    {
      "clientId": "order-platform-web",
      "name": "Order Platform public API client",
      "description": "Public OIDC client used by the web/mobile front end and by the api-gateway token route. Authorization Code + PKCE for users; Direct Access Grants are enabled for the local demo and integration tests only.",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": true,
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": true,
      "serviceAccountsEnabled": false,
      "redirectUris": [
        "http://localhost:8090/*",
        "http://localhost:3000/*"
      ],
      "webOrigins": [
        "http://localhost:8090",
        "http://localhost:3000"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "+"
      },
      "defaultClientScopes": [
        "basic",
        "profile",
        "email",
        "order-platform-audience",
        "orders:read",
        "orders:write"
      ],
      "optionalClientScopes": [
        "orders:write:any"
      ]
    },
    {
      "clientId": "order-service",
      "name": "order-service (service-to-service)",
      "description": "Confidential client for autonomous service-to-service calls (client_credentials, ADR-0009). Declared now so the flow exists; nothing depends on it in Phase 1. The secret is a local-development value only.",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "secret": "local-dev-only-order-service-secret",
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true,
      "attributes": {
        "oauth2.device.authorization.grant.enabled": "false"
      },
      "defaultClientScopes": [
        "basic",
        "order-platform-audience",
        "orders:read",
        "orders:write"
      ],
      "optionalClientScopes": [
        "orders:write:any"
      ]
    }
  ],
  "users": [
    {
      "username": "demo-customer",
      "email": "demo-customer@example.com",
      "firstName": "Demo",
      "lastName": "Customer",
      "enabled": true,
      "emailVerified": true,
      "credentials": [
        {
          "type": "password",
          "value": "demo-password",
          "temporary": false
        }
      ]
    },
    {
      "username": "other-customer",
      "email": "other-customer@example.com",
      "firstName": "Other",
      "lastName": "Customer",
      "enabled": true,
      "emailVerified": true,
      "credentials": [
        {
          "type": "password",
          "value": "other-password",
          "temporary": false
        }
      ]
    }
  ]
}
