<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.sajidriaz.orderplatform</groupId>
        <artifactId>event-driven-microservices-platform</artifactId>
        <version>0.1.0-SNAPSHOT</version>
        <relativePath>../../pom.xml</relativePath>
    </parent>

    <artifactId>order-service</artifactId>
    <name>Order Service</name>
    <description>
        Order service: saga orchestrator, REST API, transactional outbox, Kafka producer.
        See docs/architecture.md, docs/adr/0003-async-saga-orchestration.md.
    </description>

    <dependencies>
        <!-- Shared contracts -->
        <dependency>
            <groupId>com.sajidriaz.orderplatform</groupId>
            <artifactId>avro-schemas</artifactId>
        </dependency>
        <dependency>
            <groupId>com.sajidriaz.orderplatform</groupId>
            <artifactId>common-lib</artifactId>
        </dependency>

        <!-- Spring Boot starters -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webmvc</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>
        <!--
          Boot 4 split Kafka support out of spring-boot-autoconfigure into its own
          module, exactly as it did for Flyway below. Depending on the bare
          org.springframework.kafka:spring-kafka artifact compiles and even lets a
          KafkaTemplate work, but NO Kafka autoconfiguration is contributed: the
          @KafkaListener infrastructure (KafkaListenerAnnotationBeanPostProcessor /
          KafkaListenerEndpointRegistry) is never registered, so every @KafkaListener is
          silently ignored — no consumer is created, no consumer group is ever joined,
          and reply events pile up unread while the application looks healthy. That is
          precisely what was happening: the saga never advanced past PENDING.
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-kafka</artifactId>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-database-postgresql</artifactId>
        </dependency>
        <!--
          Spring Boot 4 split Flyway autoconfiguration out of spring-boot-autoconfigure
          into its own module (mirroring spring-boot-health for actuator health).
          Without this, spring.flyway.* properties are inert and no
          FlywayMigrationInitializer bean is created — Flyway silently never runs, and
          the schema is only whatever Hibernate ddl-auto happens to produce.
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-flyway</artifactId>
        </dependency>

        <!-- Database -->
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!--
          Avro payloads are serialized/deserialized to raw bytes in-process using the
          generated SpecificRecord classes (org.apache.avro:avro, transitively provided
          by avro-schemas) and carried inside the Envelope's `payload` bytes field.
          Kafka itself transports opaque byte[] via ByteArraySerializer/Deserializer.
          This deliberately avoids a dependency on the Confluent schema-registry
          serializer and its Maven repository (packages.confluent.io), keeping the
          build fully reproducible from Maven Central alone. See ADR-0010's note on the
          envelope payload being `bytes`, not a registry-validated union.
        -->

        <!-- Observability -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>

        <!-- Test dependencies -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.kafka</groupId>
            <artifactId>spring-kafka-test</artifactId>
            <scope>test</scope>
        </dependency>
        <!--
          NOTE: rest-assured is deliberately absent. Its bundled legacy Groovy
          HTTPBuilder client fails at transport level in this environment (a
          NullPointerException from ClosureMetaClass dispatch inside
          HTTPBuilder.doRequest, after the server is already up), which made every
          HTTP-touching integration test error for reasons unrelated to the
          application. The integration tests use Spring's own TestRestTemplate
          instead: it ships with spring-boot-starter-test, shares the application's
          HTTP client stack, and does not throw on 4xx — so status-code assertions
          stay explicit.
        -->
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers-junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers-postgresql</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers-kafka</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.awaitility</groupId>
            <artifactId>awaitility</artifactId>
            <version>4.2.2</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
            <!--
              Durable Ryuk disable for integration tests. The Testcontainers reaper has
              been observed reclaiming this module's Postgres container mid-run in this
              sandbox (postmaster-exit / connection-refused), and exporting
              TESTCONTAINERS_RYUK_DISABLED by hand before every build is not a fix that
              survives CI or a colleague's shell.

              Declared here rather than in the parent pom because the parent's
              surefire/failsafe configuration is out of scope for this change; the
              <includes> and the integration-test/verify executions are still inherited
              from it, this block only adds the environment. A matching
              src/test/resources/testcontainers.properties covers IDE runs, which never
              go through this plugin.

              Consequence worth knowing: with the reaper off, containers are cleaned up by
              the JVM shutdown hook instead. A hard-killed JVM can therefore leave
              containers behind, which `docker ps -a` will show.
            -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-failsafe-plugin</artifactId>
                <configuration>
                    <environmentVariables>
                        <TESTCONTAINERS_RYUK_DISABLED>true</TESTCONTAINERS_RYUK_DISABLED>
                    </environmentVariables>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
