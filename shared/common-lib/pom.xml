<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.sajidriaz.orderplatform</groupId>
        <artifactId>event-driven-microservices-platform</artifactId>
        <version>0.1.0-SNAPSHOT</version>
        <relativePath>../../pom.xml</relativePath>
    </parent>

    <artifactId>common-lib</artifactId>
    <name>Shared :: Common Library</name>
    <description>Shared platform types: envelope helpers, correlation/MDC, idempotency, saga/outbox base types.</description>

    <dependencies>
        <dependency>
            <groupId>com.sajidriaz.orderplatform</groupId>
            <artifactId>avro-schemas</artifactId>
        </dependency>
        <!-- Slf4j for MDC (correlation context); provided by Spring Boot at runtime in services -->
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-api</artifactId>
        </dependency>
        <!--
          JWT validation types for com.sajidriaz.orderplatform.common.security
          (PlatformJwtDecoders — the one definition of "a valid access token", ADR-0009).

          OPTIONAL on purpose. Marking it optional keeps it off the transitive classpath of
          every consumer, so payment-service and inventory-service — Kafka consumers with no
          customer-facing HTTP surface, and no Spring Security today — are completely
          unaffected by this addition. The resource servers (order-service, api-gateway)
          already depend on spring-boot-starter-oauth2-resource-server, which brings the same
          artifact in at the Boot-managed version, so the class resolves for them at runtime.
          Version comes from the Spring Boot 4.1.1 BOM (Spring Security 7.1.1) — not pinned here.
        -->
        <dependency>
            <groupId>org.springframework.security</groupId>
            <artifactId>spring-security-oauth2-jose</artifactId>
            <optional>true</optional>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>
